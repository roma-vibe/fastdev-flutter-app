# Public display name. Keep it on one line. Read literally; no $VAR expansion.
APP_NAME=App
# Stable namespace for local preferences; changing it selects a different data namespace.
APP_SLUG=app
# Android application ID and iOS bundle ID. Set your reverse-domain ID before distribution.
APP_IDENTIFIER=com.example.fdapp
# fastDev allocates a free port per project.
WEB_PORT=8410
